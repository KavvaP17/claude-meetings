{
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(npm run test)",
      "Bash(npm run test:e2e)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npx prisma *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "grep -oP '(?<=\"file_path\":\")[^\"]*' | while IFS= read -r f; do [ -n \"$f\" ] && npx --yes prettier --write --ignore-unknown \"$f\"; done",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
